<!--
    发布包描述符：dist/slackerdb-dist_<version>.zip

    面向“拿来就跑”的使用者：standalone jar + conf + bin + 插件，加工程说明与许可声明。
    布局说明：
      README.pdf / README-CN.pdf    工程说明（仅 -Ppdf 构建时包含）
      LICENSE                       许可声明
      jlib/                         可执行 jar（dbserver/dbproxy standalone、dbdriver、plugin api、dbcli、dbdesk）
      conf/                         运行期配置
      bin/                          启停脚本
      plugins/                      随包分发的可选插件（默认不加载）
      doc/dbcli/                    dbcli 中英文手册（仅 -Ppdf 构建时包含）

    说明：
      * LICENSE 是发行物的一部分：源码包与发布包都必须带上，否则再分发时缺少许可声明。
      * 默认构建不生成 PDF，发布包也不包含任何文档；-Ppdf 才生成并收取 README 与 dbcli 手册。
      * 各模块 target/ 下的产物由本描述符逐个点名收取，不整目录拷贝。
-->
<assembly>
    <id>deployment</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <baseDirectory>/</baseDirectory>

    <fileSets>
        <!-- 工程说明与许可声明 -->
        <fileSet>
            <directory>${project.basedir}/../</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>LICENSE</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${docs.main.dir}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>README.pdf</include>
                <include>README-CN.pdf</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbserver/target</directory>
            <outputDirectory>jlib</outputDirectory>
            <includes>
                <include>slackerdb-dbserver-*-standalone.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbserver/conf</directory>
            <outputDirectory>conf</outputDirectory>
            <includes>
                <include>dbserver.conf</include>
                <include>mcp_config_example.service</include>
                <include>data_service_example.service</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbserver/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>dbserver.sh</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbserver/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>dbserver.bat</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbproxy/target</directory>
            <outputDirectory>jlib</outputDirectory>
            <includes>
                <include>slackerdb-dbproxy-*-standalone.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbproxy/conf</directory>
            <outputDirectory>conf</outputDirectory>
            <includes>
                <include>dbproxy.conf</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbproxy/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>dbproxy.sh</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbproxy/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>dbproxy.bat</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbdriver/target</directory>
            <outputDirectory>jlib</outputDirectory>
            <includes>
                <include>slackerdb-dbdriver-*.jar</include>
            </includes>
            <excludes>
                <exclude>slackerdb-dbdriver-*sources.jar</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../plugin/target</directory>
            <outputDirectory>jlib</outputDirectory>
            <includes>
                <include>slackerdb-plugin-*.jar</include>
            </includes>
            <excludes>
                <exclude>slackerdb-plugin-*sources.jar</exclude>
            </excludes>
        </fileSet>
        <!--
            这里原先逐个收集各模块的 -sources.jar 放在 source/ 目录下。
            现已改为合并出一份可直接编译的源码工程（source.xml ->
            dist/slackerdb-src_<version>.zip），与本发布包平级，不再嵌套在包内。
        -->
        <!--
            作业调度插件（可选）：随发行版放进 plugins/ 目录，但默认不会被加载 ——
            需要部署方在 dbserver.conf 中把 plugins_dir 指向 plugins（或该插件所在目录）。
            文件名无需与 plugin.properties 里的 plugin.id 一致（PF4J 以 plugin.properties 为准）。
            HOP 运行环境不在发行包里：把 Hop 发行版放到任意目录，并用
            plugin-scheduler.hop.runScript / hop.javaHome 指向它。
        -->
        <fileSet>
            <directory>${project.basedir}/../plugin-scheduler/target</directory>
            <outputDirectory>plugins</outputDirectory>
            <includes>
                <include>slackerdb-plugin-scheduler-*.jar</include>
            </includes>
            <excludes>
                <exclude>*-sources.jar</exclude>
            </excludes>
        </fileSet>
        <!--
            dbcli（命令行客户端）：决策 15「随主发行包分发」。
            只收 standalone jar（它已含 common/plsql/dbdriver/picocli/jsch/antlr 等依赖），
            启动脚本与手册一并带上；**没有 conf**（决策 16：dbcli 不需要配置文件）。
        -->
        <fileSet>
            <directory>${project.basedir}/../dbcli/target</directory>
            <outputDirectory>jlib</outputDirectory>
            <includes>
                <include>slackerdb-dbcli-*-standalone.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbcli/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>dbcli.sh</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbcli/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>dbcli.bat</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </fileSet>
        <!--
            dbdesk（Vaadin 控制台）：Spring Boot 可执行 jar，随主发行包分发。
            没有 conf；端口用 DBDESK_PORT 环境变量或 port 参数覆盖。
            它只是管理工具：不启动、不探测、不管理 dbserver，服务端由用户自行启动。
        -->
        <fileSet>
            <directory>${project.basedir}/../dbdesk/target</directory>
            <outputDirectory>jlib</outputDirectory>
            <includes>
                <include>slackerdb-dbdesk-*-standalone.jar</include>
            </includes>
            <excludes>
                <exclude>*-sources.jar</exclude>
                <exclude>*.original</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbdesk/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>dbdesk.sh</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../dbdesk/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>dbdesk.bat</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <!--
            dbcli 的中英文用户手册只带 PDF，放在 doc/dbcli/ 下，
            避免与工程主手册的 README.pdf/README-CN.pdf 在同一个目录里混淆。
            默认构建 docs.dbcli.dir 指向空目录，因此不会收进任何文档；
            -Ppdf 时才指向 generated-docs-dbcli/。
        -->
        <fileSet>
            <directory>${docs.dbcli.dir}</directory>
            <outputDirectory>doc/dbcli</outputDirectory>
            <includes>
                <include>README.pdf</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${docs.dbcli.dir}</directory>
            <outputDirectory>doc/dbcli</outputDirectory>
            <includes>
                <include>README-CN.pdf</include>
            </includes>
        </fileSet>
    </fileSets>

</assembly>
