<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <postgres.version>42.7.2</postgres.version>
        <spring-boot.version>4.1.1</spring-boot.version>

        <!-- JDK21 关键运行时组件：版本在这里统一仲裁，模块里不再各写各的 -->
        <jna.version>5.17.0</jna.version>
        <waffle.version>3.5.1</waffle.version>
        <jetty.version>12.1.12</jetty.version>
        <!-- dbdesk 的 Vaadin 版本；BOM 与 vaadin-maven-plugin 共用 -->
        <vaadin.version>25.3.2</vaadin.version>
    </properties>

    <groupId>org.robotslacker</groupId>
    <artifactId>slackerdb</artifactId>
    <version>0.2.2</version>
    <packaging>pom</packaging>

    <modules>
        <module>common</module>
        <module>plsql</module>
        <module>dbdriver</module>
        <module>dbserver</module>
        <module>dbproxy</module>
        <module>dbcli</module>
        <module>plugin</module>
        <module>plugin-example</module>
        <module>plugin-scheduler</module>
        <module>dbdesk</module>
        <module>docs</module>
        <!-- 发行物装配：排在最后，各模块 target/ 就绪后才打 dist/src 包 -->
        <module>release</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.18</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.132.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-bom</artifactId>
                <version>${jetty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-bom</artifactId>
                <version>${jetty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot BOM（放在 Jetty/Netty 之后，避免覆盖上面的版本） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              JDK21 关键运行时组件：dbcli 的 JLine（JNA provider）、oshi 需要 JNA 5.x，
              这里统一给消费方 5.17.0 / Waffle 3.5.1。
              dbdriver 为保持 JDK17 兼容，自己在模块内钉 JNA 4.5.1 / Waffle 1.9.1；
              它的 SSPIClient 用反射同时兼容 JNA4/JNA5。
            -->
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.waffle</groupId>
                <artifactId>waffle-jna</artifactId>
                <version>${waffle.version}</version>
            </dependency>

            <!-- dbcli：命令行客户端专用依赖（版本在此统一仲裁） -->
            <!-- 命令行参数解析 -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>4.7.7</version>
            </dependency>
            <!-- 交互式控制台（行编辑/历史/补全/多行续行） -->
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline</artifactId>
                <version>3.26.3</version>
            </dependency>
            <!-- SSH/SFTP（_SSH 命令） -->
            <dependency>
                <groupId>com.github.mwiede</groupId>
                <artifactId>jsch</artifactId>
                <version>0.2.18</version>
            </dependency>
            <!--
              跨进程会合点（_JOB 的 mode=process）：SQLite 单文件库。
            -->
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>3.51.1.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JSON对象解析 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.61</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.18.0</version>
        </dependency>

        <!-- 日志组件 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>1.5.38</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.38</version>
        </dependency>

        <!-- 以下为测试组件 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgres.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  ============================================================
                  产品各模块的 Maven 插件版本统一在此维护（含 Vaadin 和
                  offline-package 插件的使用版本）；各模块 POM 只写配置，
                  不再写 <version>。
                  offline-package-maven-plugin 作为独立构建工具不继承本 POM，
                  它自身构建插件（compiler/plugin/surefire）的版本留在其 POM。
                  plugin-example 是独立示例（无 parent），版本集中在它自己的
                  pluginManagement 中，刻意与其他模块同版。
                  ============================================================
                -->
                <!-- 核心生命周期插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <!-- Spring Boot / 文档 / 构建辅助插件 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.asciidoctor</groupId>
                    <artifactId>asciidoctor-maven-plugin</artifactId>
                    <version>2.2.2</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
                <plugin>
                    <groupId>org.antlr</groupId>
                    <artifactId>antlr4-maven-plugin</artifactId>
                    <version>4.13.2</version>
                </plugin>
                <plugin>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-maven-plugin</artifactId>
                    <version>${vaadin.version}</version>
                </plugin>

                <!-- 项目内构建插件 -->
                <plugin>
                    <groupId>org.robotslacker.tools</groupId>
                    <artifactId>offline-package-maven-plugin</artifactId>
                    <version>1.0.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
              JDK/Maven 硬门槛：避免在 17 或旧 Maven 上误构建。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-jdk21-maven39</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.16]</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <filesets>
                        <!--
                            注意：这里不清理 offline/。离线包既是产物又是离线构建的
                            `-Dmaven.repo.local.tail` 仓库；若 `mvn clean` 删掉它，离线机上
                            `mvn -o ... clean package` 会在第一步就把自己依赖的仓库删掉。
                            重新生成时由 offline-package:collect 自己整体替换输出目录
                            （CollectMojo 先写 staging 再替换），不需要 clean 参与。
                        -->
                        <!--
                            发行物输出目录由根项目清理：dist 不再属于某个模块
                            （文档包由 docs 模块产出，dist/src 包由 release 产出），
                            放在根项目能保证 `mvn clean package` 一开始就清空，
                            不会出现"后一个模块的 clean 抹掉前一个模块刚写的包"。
                            注意 `-pl docs clean` 不会选中根项目，因此不会误删已有发行包。
                        -->
                        <fileset>
                            <directory>${project.basedir}/dist</directory>
                            <includes>
                                <include>**</include>
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            离线包插件自身：独立 POM，不继承本 POM。
            用 profile 门控，正常 `mvn package` 不构建它。
            先安装插件，再执行 collect：
                mvn -f offline-package-maven-plugin/pom.xml install
                mvn -Poffline-package validate
        -->
        <profile>
            <id>offline-package</id>
            <properties>
                <offline.dir>${project.basedir}/offline</offline.dir>
            </properties>
            <!-- 让 collect 也看到插件自身，才能把构建插件所需的 Maven 插件收进 javarepo。 -->
            <modules>
                <module>offline-package-maven-plugin</module>
            </modules>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.robotslacker.tools</groupId>
                        <artifactId>offline-package-maven-plugin</artifactId>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>collect-offline-package</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>collect</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${offline.dir}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
