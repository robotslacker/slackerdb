<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>slackerdb-dbproxy</artifactId>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.robotslacker</groupId>
        <artifactId>slackerdb</artifactId>
        <version>0.2.2</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencies>
        <dependency>
            <groupId>org.robotslacker</groupId>
            <artifactId>slackerdb-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.robotslacker</groupId>
            <artifactId>slackerdb-dbserver</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.132.Final</version>
            <!--
              Linux UDS 依赖 Netty epoll native，必须保留 epoll 分类器；
              Windows 不使用 epoll（回退 NIO），macOS 不在目标范围。
              kqueue / resolver-dns-native-macos 只服务 macOS，排除。
            -->
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-kqueue</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-resolver-dns-native-macos</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- javalin 用来实现portX请求；不需要 Brotli 压缩，排除 bundle 里的 brotli4j，回退到 gzip -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin-bundle</artifactId>
            <version>7.2.3</version>
            <exclusions>
                <exclusion>
                    <groupId>com.aayushatharva.brotli4j</groupId>
                    <artifactId>brotli4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- oshi-core for system information -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>6.9.2</version>
        </dependency>

        <!-- Spring Boot Test (test scope, no embedded web server) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Exclude embedded web server to avoid conflict with Javalin -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
                <!-- Exclude JUnit 4 vintage engine since we use JUnit 6 -->
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
            Boot 4 把自动配置拆到了独立模块：SpringBootProxyTest 用到的
            DataSourceAutoConfiguration / DataSourceInitializationAutoConfiguration
            都在 spring-boot-jdbc，必须显式加入 test classpath。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
            </plugin>
                        <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <!--
                      源码包（<artifactId>-<version>-sources.jar）：口径见 release/src/main/assembly/sources-assembly.xml ——
                      与 git 里提交的 src/main 树一致（java + antlr4 语法 + 资源），不含任何构建产物。
                    -->
                    <execution>
                        <id>sources-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>${project.basedir}/../release/src/main/assembly/sources-assembly.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!--
                      构建信息（generate-resources 阶段）：生成 target/classes/META-INF/build-info.properties，
                      键名是 Spring Boot 的公共约定 build.artifact / build.group / build.name /
                      build.version / build.time（读取见 common 的 org.slackerdb.common.version.BuildInfo）。

                      它取代了原来“src/main/resources 里放 version.properties + 资源过滤”的写法：
                        - 源码树里不再有可手工编辑的版本文件（那份文件曾经是“jar 与 POM 不一致”的唯一入口）；
                        - build.time 是 ISO-8601 的 **UTC 瞬时**，取 project.build.outputTimestamp，
                          没设置时取本次 Maven 会话的启动时刻（同一次 reactor 构建里各模块一致），
                          要可复现构建就显式传 -Dproject.build.outputTimestamp=...；
                        - 取值里不会留下 ${...} 占位符，运行期也不再有“把占位符印给用户”的降级路径。
                    -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>repackage-standalone</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>standalone</classifier>
                            <mainClass>
                                org.slackerdb.dbproxy.Main
                            </mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED -XX:+EnableDynamicAgentLoading -Djdk.instrument.traceUsage=false</argLine>
                    <!--
                        按命名约定自动纳入：所有以 Test 结尾的测试类都会被 mvn test 执行。
                        这里**必须**用通配（与 dbserver/pom.xml 一致），不能再写"随用随加"的显式白名单：
                        白名单曾把 CancelTest（取消请求 + 启动报文契约，10 个用例）整类挡在构建之外，
                        导致"修正 CancelRequest 不生效"的提交根本没有回归测试在跑。
                    -->
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <parallel>none</parallel> <!-- Disable parallel execution -->
                    <forkCount>1</forkCount>  <!-- Execute tests in a single process -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
