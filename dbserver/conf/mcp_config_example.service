{
  "tools": [
    {
      "name": "echo",
      "description": "Connectivity probe: echo back the given text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The text to echo back"
          }
        },
        "required": ["text"]
      },
      "category": "utility"
    },
    {
      "name": "query",
      "description": "Run read-only SQL against SlackerDB. 'query' is a legacy alias, mapped onto the builtin run_sql.",
      "category": "database",
      "handler": "builtin:query"
    },
    {
      "name": "top_tables",
      "description": "List tables and views, bound to the builtin list_tables but exposed under this name.",
      "category": "database",
      "handler": "builtin:list_tables"
    },
    {
      "name": "peek_rows",
      "description": "Sample real values from one table, bound to the builtin sample_rows but exposed under this name.",
      "category": "database",
      "handler": "builtin:sample_rows"
    }
  ],
  "resources": [
    {
      "uri": "docs://mcp/config-example",
      "name": "MCP configuration example",
      "description": "Static text served verbatim from the contents field of this file.",
      "mimeType": "text/plain",
      "category": "documentation",
      "contents": "This resource is declared in mcp_config_example.service and served from its own contents field: nothing is read from disk, so the URI is a label, not a path."
    }
  ]
}
