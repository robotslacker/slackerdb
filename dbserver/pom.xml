<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>slackerdb-dbserver</artifactId>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.robotslacker</groupId>
        <artifactId>slackerdb</artifactId>
        <version>0.2.2</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <properties>
        <commons.cli.version>1.6.0</commons.cli.version>
    </properties>

    <dependencies>
        <!-- Quartz：plugin-scheduler 把 quartz 声明成 provided（由宿主提供）。
             不在这里带上，插件启动时会 NoClassDefFoundError，/scheduler/* 路由静默不注册。
             版本由 Boot 4.1.1 BOM 统一管理（2.5.2），与 plugin-scheduler 编译版本一致。 -->
        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.robotslacker</groupId>
            <artifactId>slackerdb-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- slackerdb JDBC 驱动（test scope，用于 UDS 测试） -->
        <dependency>
            <groupId>org.robotslacker</groupId>
            <artifactId>slackerdb-dbdriver</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.robotslacker</groupId>
            <artifactId>slackerdb-plsql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.robotslacker</groupId>
            <artifactId>slackerdb-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- DuckDB 数据库驱动 -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>2.0.0.0</version>
        </dependency>
        <!-- PF4J 插件 -->
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <version>3.13.0</version>
        </dependency>
        <!-- NETTY 驱动 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.132.Final</version>
            <!--
              Linux UDS 依赖 Netty epoll native，必须保留 epoll 分类器；
              Windows 不使用 epoll（回退 NIO），macOS 不在目标范围。
              kqueue / resolver-dns-native-macos 只服务 macOS，排除。
            -->
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-kqueue</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-resolver-dns-native-macos</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 数据库连接池 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.2.1</version>
            <scope>test</scope>
        </dependency>
        <!-- SQL语法解析 -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.13.2</version>
        </dependency>
        <!-- javalin 用来实现portX请求；不需要 Brotli 压缩，排除 bundle 里的 brotli4j，回退到 gzip -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin-bundle</artifactId>
            <version>7.2.3</version>
            <exclusions>
                <exclusion>
                    <groupId>com.aayushatharva.brotli4j</groupId>
                    <artifactId>brotli4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
          Jetty 版本由父 POM 的 jetty-bom 统一为 12.1.12（与 Javalin 7.2.3 一致）。
          这里只声明代码直接使用的 API，不写版本，避免 12.0/12.1 混用。
        -->
        <dependency>
            <groupId>org.eclipse.jetty.websocket</groupId>
            <artifactId>jetty-websocket-jetty-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.6.0</version>
        </dependency>
        <!-- 查询结果缓存 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.2.0</version>
        </dependency>
        <!-- 自动过期的Map -->
        <dependency>
            <groupId>net.jodah</groupId>
            <artifactId>expiringmap</artifactId>
            <version>0.5.11</version>
        </dependency>
        <!-- oshi-core for system information -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>6.9.2</version>
        </dependency>

        <!-- Spring Boot Test (test scope, no embedded web server) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Exclude embedded web server to avoid conflict with Javalin -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
                <!-- Exclude JUnit 4 vintage engine since we use JUnit 6 -->
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
            Boot 4 把自动配置拆到了独立模块：SpringBootDBTest 用到的
            DataSourceAutoConfiguration / DataSourceInitializationAutoConfiguration
            都在 spring-boot-jdbc，必须显式加入 test classpath。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!--
                COPY 语句文法（CopyStatement.g4）的生成：
                源在 src/main/antlr4 下，官方插件在 generate-sources 阶段生成到
                target/generated-sources/antlr4/（自动注册为源码根），包名与手写类
                （CopyVisitor / ParserErrorListener / ParseSQLException）一致，
                因此调用方与手写类都无需改动；mvn clean 天然清掉，git 也看不到生成物。
            -->
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>antlr-generate-copy-statement</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/main/antlr4</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/antlr4</outputDirectory>
                            <visitor>true</visitor>
                            <listener>false</listener>
                            <arguments>
                                <argument>-package</argument>
                                <argument>org.slackerdb.dbserver.sql.antlr</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED -XX:+EnableDynamicAgentLoading -Djdk.instrument.traceUsage=false</argLine>
                    <!--
                        随用随加的显式清单极易漏登记（历史上 CopySanityTest
                        [原 CopyCsvSemanticsTest / CopyFailureAtomicityTest / sql/CopyCsvReaderTest 已合并至此]、
                        SqlReplacerCacheTest 以及 Sanity01~03Test、
                        ClientTest、HistoryQueueTest、PluginManagerTest、RowEncoderTest、
                        SessionConcurrencyTest、SqlReplacerGoldenTest、BusinessExecutorTest、
                        PlSqlTest 都因此被 mvn test 静默跳过）。
                        这里改为按命名约定自动纳入：所有以 Test 结尾的测试类都会被 mvn test 执行，
                        新增测试只要遵守 *Test.java 命名即可自动生效，无需再改 pom。
                    -->
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <!--
                            以下测试不适合放进 mvn test 的自动化套件，故永久排除：
                            1) TPCDS：TPCDSTest 依赖外部 TPCDS 数据集且耗时极长，TpcdsSQL 只是它的
                               SQL 语料库（非测试类），两者都需要手工单独执行。
                            2) End-to-End：CustomerEndToEndTest 属于端到端用例，依赖完整外部环境，
                               不纳入常规自动化执行。
                        -->
                        <exclude>**/TPCDSTest.java</exclude>
                        <exclude>**/TpcdsSQL.java</exclude>
                        <exclude>**/CustomerEndToEndTest.java</exclude>
                    </excludes>
                    <parallel>none</parallel> <!-- Disable parallel execution -->
                    <forkCount>1</forkCount>  <!-- Execute tests in a single process -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
            <!--
                COPY BINARY 入库性能基准的入口（手工执行，不属于 mvn test 套件）。

                基准类刻意不叫 *Test.java：性能数字必须能前后对比，写成用例既会让 mvn test
                每次都跑百万行，又会把机器噪声变成断言。用法（须用 JDK 21）：

                  mvn -o -q -pl dbserver test-compile
                  mvn -o -pl dbserver exec:java -Dexec.classpathScope=test \
                      -Dexec.mainClass=org.slackerdb.dbserver.test.CopyBinaryPerf \
                      -DcopyPerf.rows=1000000 -DcopyPerf.rounds=3

                结果打印到控制台并写入 dbserver/target/copy-binary-perf/。
                优化前后的实测对比与边界语义记录见 src/test/resources/copy-binary-perf.md。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
                        <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <!--
                      源码包（<artifactId>-<version>-sources.jar）：口径见 build/sources-assembly.xml ——
                      与 git 里提交的 src/main 树一致（java + antlr4 语法 + 资源），不含任何构建产物。
                    -->
                    <execution>
                        <id>sources-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>${project.basedir}/../build/sources-assembly.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!--
                      构建信息（generate-resources 阶段）：生成 target/classes/META-INF/build-info.properties，
                      键名是 Spring Boot 的公共约定 build.artifact / build.group / build.name /
                      build.version / build.time（读取见 common 的 org.slackerdb.common.version.BuildInfo）。

                      它取代了原来“src/main/resources 里放 version.properties + 资源过滤”的写法：
                        - 源码树里不再有可手工编辑的版本文件（那份文件曾经是“jar 与 POM 不一致”的唯一入口）；
                        - build.time 是 ISO-8601 的 **UTC 瞬时**，取 project.build.outputTimestamp，
                          没设置时取本次 Maven 会话的启动时刻（同一次 reactor 构建里各模块一致），
                          要可复现构建就显式传 -Dproject.build.outputTimestamp=...；
                        - 取值里不会留下 ${...} 占位符，运行期也不再有“把占位符印给用户”的降级路径。
                    -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>repackage-standalone</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>standalone</classifier>
                            <mainClass>
                                org.slackerdb.dbserver.Main
                            </mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
