<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>slackerdb-docs</artifactId>
    <packaging>pom</packaging>

    <parent>
        <groupId>org.robotslacker</groupId>
        <artifactId>slackerdb</artifactId>
        <version>0.2.2</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!--
        文档模块：把仓库根的 README 与 dbcli 用户手册渲染成 PDF，再打成一个文档包
        dist/slackerdb-docs_<version>.zip。发行包（dist/src）不在这里，在 release 模块。

        - 默认不生成 PDF，也不产出文档包；-Ppdf 才打开 asciidoctor 并打文档包；
        - 因为装配不在本模块，`mvn -Ppdf -pl docs package` 只重生成文档，
          不会用别的模块的旧 target 产物重打发行包。
    -->
    <properties>
        <asciidoctor.skip>true</asciidoctor.skip>
    </properties>

    <build>
        <plugins>
            <!--
                文档 PDF 由 asciidoctor（JRuby）生成。JRuby 的 Encoding.default_external 取自 Maven
                这个 JVM 的 file.encoding：在 zh-CN Windows 上用 JDK 17 及更早版本构建时它是 GBK，于是
                jruby-stdlib 里自带的 jar-dependencies 读 **UTF-8 的** conf/settings.xml 会报

                    error reading or parsing <M2_HOME>/conf/settings.xml

                （Kernel.warn 直打 stderr，没有 [WARNING] 前缀，容易被当成 Maven 自身的错误；
                实际不影响产物，PDF 照常生成）。

                仓库**不**固定构建 JVM 的字符集（不再放 .mvn/jvm.config），需要时在构建环境里给一条：

                    MAVEN_OPTS=-Dfile.encoding=UTF-8 mvn clean package

                或者直接用当前最低要求的 JDK 21（默认字符集已是 UTF-8）。详见 README 的“从源码构建”。
            -->
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-pdf</artifactId>
                        <version>2.3.23</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jruby</groupId>
                        <artifactId>jruby-core</artifactId>
                        <version>9.4.6.0</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jruby</groupId>
                        <artifactId>jruby-stdlib</artifactId>
                        <version>9.4.6.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <skip>${asciidoctor.skip}</skip>
                    <sourceDirectory>${project.basedir}/..</sourceDirectory>
                    <outputDirectory>${project.build.directory}/generated-docs</outputDirectory>
                    <backend>pdf</backend>
                    <!--
                        只把 README 及其封面图复制到输出目录。
                        如不限定 resources，插件会把整个 sourceDirectory（仓库根目录，
                        含各模块 target 与 dist 压缩包）整体复制进 generated-docs，
                        且输出目录位于被复制目录之内，会随每次构建自我嵌套。
                    -->
                    <resources>
                        <resource>
                            <directory>${project.basedir}/..</directory>
                            <includes>
                                <include>README.adoc</include>
                                <include>README-CN.adoc</include>
                                <include>robotslacker.jpg</include>
                                <!-- dbcli 用户手册（中英双语，决策 13/15） -->
                                <include>dbcli/README.adoc</include>
                                <include>dbcli/README-CN.adoc</include>
                            </includes>
                        </resource>
                    </resources>
                </configuration>
                <executions>
                    <!-- 英文 PDF：README.adoc -> README.pdf -->
                    <execution>
                        <id>generate-pdf-documentation</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDocumentName>README.adoc</sourceDocumentName>
                            <attributes>
                                <icons>font</icons>
                            </attributes>
                        </configuration>
                    </execution>
                    <!--
                        中文 PDF：README-CN.adoc -> README-CN.pdf
                        （文档名去掉 .adoc 后缀即输出文件名，两次执行互不覆盖）
                        中文必须换用带 CJK 回退字体的主题，否则简体字会整片缺字——
                        原因与字体来源见 src/main/resources/pdf/README-CN-theme.yml 的注释。
                    -->
                    <execution>
                        <id>generate-pdf-documentation-cn</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDocumentName>README-CN.adoc</sourceDocumentName>
                            <attributes>
                                <icons>font</icons>
                                <pdf-theme>${project.basedir}/src/main/resources/pdf/README-CN-theme.yml</pdf-theme>
                            </attributes>
                        </configuration>
                    </execution>
                    <!--
                        dbcli 用户手册（中英双语）：源文件在 dbcli/ 下。
                        **必须给独立输出目录**：asciidoctor-maven-plugin 的输出名取自
                        sourceDocumentName 的**文件名**（README.adoc → README.pdf），不保留子目录，
                        若沿用顶层 generated-docs 会把工程主手册的 README.pdf/README-CN.pdf 覆盖掉
                        （实测发生过）。产物由 docs.xml 放到文档包的 dbcli/ 目录。
                        中文同样要换 CJK 主题。
                    -->
                    <execution>
                        <id>generate-pdf-documentation-dbcli</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDocumentName>dbcli/README.adoc</sourceDocumentName>
                            <outputDirectory>${project.build.directory}/generated-docs-dbcli</outputDirectory>
                            <attributes>
                                <icons>font</icons>
                            </attributes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-pdf-documentation-dbcli-cn</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDocumentName>dbcli/README-CN.adoc</sourceDocumentName>
                            <outputDirectory>${project.build.directory}/generated-docs-dbcli</outputDirectory>
                            <attributes>
                                <icons>font</icons>
                            </attributes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        PDF profile：
          mvn -Ppdf package                       完整构建：dist 包 + src 包 + docs 包
          mvn -Ppdf -pl docs package              只重生成文档：只产出 docs 包
        - 打开 asciidoctor，生成 README / README-CN 与 dbcli 中英文 PDF；
        - 把四个 PDF 收进 dist/slackerdb-docs_<version>.zip（README*.pdf 在根，dbcli 手册在 dbcli/）。
    -->
    <profiles>
        <profile>
            <id>pdf</id>
            <properties>
                <asciidoctor.skip>false</asciidoctor.skip>
                <docs.main.dir>${project.build.directory}/generated-docs</docs.main.dir>
                <docs.dbcli.dir>${project.build.directory}/generated-docs-dbcli</docs.dbcli.dir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <appendAssemblyId>false</appendAssemblyId>
                            <outputDirectory>${project.basedir}/../dist</outputDirectory>
                        </configuration>
                        <executions>
                            <!--
                                文档包。只在 pdf profile 里装配：没有生成 PDF 的构建不该往
                                dist/ 里丢一个空 zip（也避免默认构建的产物清单里多出一个文件）。
                            -->
                            <execution>
                                <id>make-docs-assembly</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/assembly/docs.xml</descriptor>
                                    </descriptors>
                                    <finalName>slackerdb-docs_${project.version}</finalName>
                                    <attach>false</attach>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
