<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.robotslacker</groupId>
        <artifactId>slackerdb</artifactId>
        <version>0.2.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <hop.version>2.17.0</hop.version>
    </properties>

    <artifactId>slackerdb-plugin-scheduler</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Logging components -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>1.5.32</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.32</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
            <scope>provided</scope>
        </dependency>

        <!-- DuckDB database driver -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>1.5.6.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Javalin (compile scope so tests can use it) -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin-bundle</artifactId>
            <version>7.2.2</version>
        </dependency>

        <!-- PF4J plugin framework -->
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <version>3.13.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.robotslacker</groupId>
            <artifactId>slackerdb-plugin</artifactId>
            <version>0.2.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Quartz scheduler -->
        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- FastJSON -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.61</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.48</version>
            <scope>provided</scope>
        </dependency>

        <!--
            HOP 运行环境不在依赖里（方案 A：Hop 独立目录 + hop-run 命令行，非内嵌）。
            内嵌 Hop 需要把 hop-core/hop-engine 及其全部插件打进插件包（数十~上百 MB），
            并且会破坏 Hop 的插件发现（Jandex 索引在 shade 时被覆盖，实测会报
            "Unable to find the plugin ... id: Local"），还会与数据库进程共用堆与故障域。
            因此插件只依赖 JRE 的进程能力，HOP 由 <scheduler.home>/hop 下的发行版承担。
        -->
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                    <showWarnings>true</showWarnings>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.48</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        SchedulerCrontabTester / SchedulerRunOnceTester / SchedulerHopEndToEndTester
                        都是带 main() 的独立端到端 (End-to-End) 程序：它们会真实启动 Javalin + Quartz
                        并通过 HTTP 驱动调度、执行脚本（后者还会真实调用本机 HOP），还各自占用固定端口，
                        不适合放进 mvn test。
                        这里显式排除它们（并保留 surefire 默认的 *Test 命名约定），
                        以免将来误以为本模块的测试被 mvn test 覆盖，实际却被静默跳过。
                        需要手工执行时请直接运行上述类的 main()（见 README 与各类的类注释）。
                    -->
                    <excludes>
                        <exclude>**/SchedulerCrontabTester.java</exclude>
                        <exclude>**/SchedulerRunOnceTester.java</exclude>
                        <exclude>**/SchedulerHopEndToEndTester.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
                手动端到端验收程序（真实 HOP）：
                  mvn -pl plugin-scheduler -am -DskipTests test-compile
                  mvn -pl plugin-scheduler exec:java -Dexec.args="C:/Softwares/hop/hop-run.bat"
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>org.slackerdb.plugins.scheduler.SchedulerHopEndToEndTester</mainClass>
                    <classpathScope>test</classpathScope>
                    <!-- 固定工作目录，保证产物落在 plugin-scheduler/target/e2e-home -->
                    <workingDirectory>${project.basedir}</workingDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>sources</classifier>
                            <includes>
                                <include>**/*.java</include>
                                <include>**/*.adoc</include>
                                <include>**/plugin.properties</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
